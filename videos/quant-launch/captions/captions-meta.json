{
  "source": "authored visual cues; no narration",
  "timeline_duration": 60,
  "lines": [
    {
      "id": "cap01",
      "text": "把选股、回测、复盘，交给一个AI工作台。",
      "start": 0.12,
      "end": 4.8,
      "duration": 4.68,
      "scene": "s1"
    },
    {
      "id": "cap02",
      "text": "这是Quant。",
      "start": 4.8,
      "end": 6.95,
      "duration": 2.15,
      "scene": "s1"
    },
    {
      "id": "cap03",
      "text": "自选股、纳指一百、标普五百，汇入同一个研究池。",
      "start": 7.2,
      "end": 12.3,
      "duration": 5.1,
      "scene": "s2"
    },
    {
      "id": "cap04",
      "text": "捕捉异动，追踪资讯，让机会持续进入视野。",
      "start": 12.3,
      "end": 17.95,
      "duration": 5.65,
      "scene": "s2"
    },
    {
      "id": "cap05",
      "text": "AI提出假设、生成因子。",
      "start": 18.2,
      "end": 21.4,
      "duration": 3.2,
      "scene": "s3"
    },
    {
      "id": "cap06",
      "text": "程序回测、独立核账，逐层筛选。",
      "start": 21.4,
      "end": 25.2,
      "duration": 3.8,
      "scene": "s3"
    },
    {
      "id": "cap07",
      "text": "每个策略，都能追到判断依据。",
      "start": 25.2,
      "end": 28.95,
      "duration": 3.75,
      "scene": "s3"
    },
    {
      "id": "cap08",
      "text": "收益曲线只是起点。",
      "start": 29.2,
      "end": 32.1,
      "duration": 2.9,
      "scene": "s4"
    },
    {
      "id": "cap09",
      "text": "成本、回撤、延迟，都要经受检验。",
      "start": 32.1,
      "end": 35.4,
      "duration": 3.3,
      "scene": "s4"
    },
    {
      "id": "cap10",
      "text": "每一个买卖点，都能展开交易明细。",
      "start": 35.4,
      "end": 39.95,
      "duration": 4.55,
      "scene": "s4"
    },
    {
      "id": "cap11",
      "text": "先做未来观察，再进入模拟盘。",
      "start": 40.2,
      "end": 43.6,
      "duration": 3.4,
      "scene": "s5"
    },
    {
      "id": "cap12",
      "text": "复盘提出新假设，冻结策略保留原规则。",
      "start": 43.6,
      "end": 47.5,
      "duration": 3.9,
      "scene": "s5"
    },
    {
      "id": "cap13",
      "text": "实盘，始终需要人工授权。",
      "start": 47.5,
      "end": 50.95,
      "duration": 3.45,
      "scene": "s5"
    },
    {
      "id": "cap14",
      "text": "市场、策略、交易、复盘，一屏掌握。",
      "start": 51.2,
      "end": 55.6,
      "duration": 4.4,
      "scene": "s6"
    },
    {
      "id": "cap15",
      "text": "Quant，让研究有据可查。",
      "start": 55.6,
      "end": 59.6,
      "duration": 4.0,
      "scene": "s6"
    }
  ]
}
