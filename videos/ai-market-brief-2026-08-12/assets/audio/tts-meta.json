      "start": 31.944,
      "end": 35.976,
      "scene": "scene-04"
    },
    {
      "id": "cap10",
      "text": "但市场开始要求订单、利润和现金流一起兑现。",
      "path": "assets/audio/segments/cap10.mp3",
      "duration": 4.416,
      "start": 36.036,
      "end": 40.452,
      "scene": "scene-04"
    },
    {
