      "duration": 4.8,
      "start": 2.244,
      "end": 7.044,
      "scene": "scene-01"
    },
    {
      "id": "cap03",
      "text": "昨夜标普跌零点三二，纳指跌零点六，",
      "path": "assets/audio/segments/cap03.mp3",
      "duration": 4.032,
      "start": 7.104,
      "end": 11.136,
      "scene": "scene-02"
    },
    {
      "id": "cap04",
      "text": "半导体ETF却涨近一个点；",
      "path": "assets/audio/segments/cap04.mp3",
      "duration": 3.144,
      "start": 11.196,
      "end": 14.34,
      "scene": "scene-02"
    },
    {
      "id": "cap05",
      "text": "布伦特仍在八十八美元上方，",
      "path": "assets/audio/segments/cap05.mp3",
      "duration": 2.592,
      "start": 14.4,
      "end": 16.992,
      "scene": "scene-03"
    },
    {
      "id": "cap06",
      "text": "今晚八点半的七月CPI才是方向开关。",
